# Copy this file to `.env` (same directory) and fill in real values.
# .env is loaded by run_job_agent.sh -- never commit it or share it.

ANTHROPIC_API_KEY=sk-ant-your-key-here
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# --- Email (only needed if CONFIG["email"]["enabled"] = True) ---
# Gmail example: use an "App Password", not your normal password.
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_FROM=you@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_TO=you@gmail.com
